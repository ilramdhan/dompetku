# Dompetku environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development, or add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# Full reference (what each one does, how to get it): docs/ENVIRONMENT.md
# NEVER commit your real `.env` — it holds secrets.

# ===== 1. Database (required) ==============================================
# Supabase → Project Settings → Data API (Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_…) or the
# legacy "service_role" key. Server-only: it bypasses all row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# ===== 2. Login (required) =================================================
# The single user allowed to sign in to the web app.
APP_USERNAME=
APP_PASSWORD=
# Random string, at least 32 characters. Signs the login cookie.
# Generate: openssl rand -base64 48
SESSION_SECRET=
# Optional two-step login (TOTP, 6-digit codes). Base32 key from
# Settings → Two-step verification (2FA). Empty = password-only login.
APP_TOTP_SECRET=

# ===== 3. Automation API for n8n (required for bot/reminders/backups) ======
# Random string, at least 24 characters. n8n sends it in the `x-api-key` header.
# Shorter or empty = every /api/public/n8n/* endpoint answers 503.
N8N_API_KEY=

# ===== 4. AI for receipt OCR and chat parsing (optional) ====================
# Any OpenAI-compatible chat-completions endpoint (full URL, ending in
# /chat/completions). Example (Google Gemini):
#   AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_URL=
AI_API_KEY=
# Vision-capable model used for receipt photos (e.g. gemini-2.5-flash, gpt-4o-mini).
AI_MODEL=
# Optional cheaper model for parsing chat messages. Defaults to AI_MODEL.
AI_MODEL_TEXT=
# Lovable-hosted only: used as the AI key when AI_API_KEY is empty (Lovable sets it).
# LOVABLE_API_KEY=

# ===== 5. Telegram bot (required only if you use the bot) ==================
# Comma-separated Telegram chat IDs allowed to use the bot.
# Empty = every chat is refused (the bot replies with the chat ID to add).
BOT_ALLOWED_CHAT_IDS=
# Account name used when a bot message does not mention one (e.g. BCA).
# Can be overridden in Settings → Aplikasi (schema v14).
BOT_DEFAULT_ACCOUNT=
# When chat messages may use AI: auto (only when ambiguous) | always | never
BOT_TEXT_AI=auto
# Max bot AI calls (chat parsing + photo OCR) per chat per day. Empty = 50, 0 = unlimited.
# Counted in the ai_usage table (schema v15).
BOT_AI_DAILY_LIMIT=

# ===== 6. Regional settings (optional) =====================================
# IANA time zone that decides what "today" means. Default: Asia/Jakarta.
# Can be overridden in Settings → Aplikasi (schema v14).
APP_TIMEZONE=Asia/Jakarta
# USD→IDR rate used only when the live exchange-rate API fails and no rate is
# stored yet. Default: 16000.
FALLBACK_USD_IDR=

# ===== 7. Email reminders via Resend (optional) ============================
# All three are needed for /api/public/n8n/reminders-send-email.
RESEND_API_KEY=
# Sender on a domain you verified in Resend.
EMAIL_FROM=Dompetku <noreply@mail.example.com>
# Recipient(s), comma-separated.
EMAIL_TO=you@example.com

# ===== 8. Error monitoring (optional) ======================================
# Sentry project DSN (Sentry → Project Settings → Client Keys). Without it,
# errors are still written as one JSON line to the Vercel logs.
SENTRY_DSN=

# ===== 9. Public demo (optional, see docs/DEMO.md) =========================
# ONLY on a separate demo deployment with its own throwaway Supabase project:
# "true" publishes APP_USERNAME/APP_PASSWORD on the login page. Never on real data.
DEMO_MODE=
# On your main instance: link to a public demo (shows "Coba demo" on the landing
# page). Must be https://; empty = hidden.
# Example: PUBLIC_DEMO_URL=https://demo.dompetku.ilramdhan.dev
PUBLIC_DEMO_URL=

# ===== 10. Local development only (not needed on Vercel) ===================
# Supabase project ref for `npm run gen:types` (regenerates database types).
SUPABASE_PROJECT_ID=

# ===== Set automatically by the platform — do not set these yourself =======
# VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (Vercel) and NODE_ENV are read by
# the build/monitoring code but are provided by the runtime.
