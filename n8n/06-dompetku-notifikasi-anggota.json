{
  "name": "Dompetku – Notifikasi per Anggota",
  "nodes": [
    {
      "parameters": {
        "content": "## 👥 Dompetku — Per-member notifications (optional, schema v22)\nAlternative to workflow 02: same schedules, but each recipient gets their own message. The owner (TELEGRAM_ADMIN_CHAT_ID from Settings → Integrasi, else app env) gets the all-wallet text; each member set in Settings → Pengguna → 🔔 gets only their wallets. **Use 02 or 06, not both** (the owner would get every message twice).\n\nEnv: `FINTRACK_URL`, `TELEGRAM_BOT_TOKEN`. Credential: Header Auth `x-api-key` (replace `REPLACE_ME` on all 4 HTTP nodes). Recipients with no bills due are skipped by the app.",
        "height": 260,
        "width": 640,
        "color": "6"
      },
      "id": "081d776a-20e7-44cc-8db3-b585ec0e674e",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-40, -260]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "8cb07db1-14c1-4756-80fc-f714d9928ea1",
      "name": "Tiap hari 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FINTRACK_URL }}/api/public/n8n/notifications?kind=reminders&days=3",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "539064a3-8132-4a03-8218-5873a0f44e6c",
      "name": "Tagihan ≤ 3 hari",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Fintrack x-api-key"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 21
            }
          ]
        }
      },
      "id": "385adda3-8e21-453c-a551-b0366be7f133",
      "name": "Tiap hari 21:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.FINTRACK_URL }}/api/public/n8n/notifications?kind=report&period=today",
        "options": {
          "timeout": 30000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "233ae2f1-aea5-43d1-8f24-0ddbe47f62c1",
      "name": "Rekap hari ini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Fintrack x-api-key"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "weeksInterval": 1,
              "triggerAtDay": [1],
              "triggerAtHour": 7,
              "triggerAtMinute": 30
            }
