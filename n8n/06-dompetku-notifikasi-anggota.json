      "id": "4b50593f-c702-4531-a0e2-846994844dc4",
      "name": "Pisah per penerima",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.chat_id, text: String($json.text || '').slice(0, 4000), disable_web_page_preview: true }) }}"
      },
      "id": "5971d950-a8f1-4b59-8af8-7158014091d1",
      "name": "Kirim ke Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
